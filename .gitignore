# Strictly exclude all user-uploaded and user-generated media (no private videos, clips, audio, thumbnails, or exports)
public/videos/*
!public/videos/.gitkeep
public/clips/*
!public/clips/.gitkeep
public/thumbnails/*
!public/thumbnails/.gitkeep
public/gifs/*
!public/gifs/.gitkeep
public/audio/*
!public/audio/.gitkeep
public/exports/*
